# Local settings. `uv run start` copies this file to .env on its first run; edit .env, not
# this file. Variables already set in the environment win over .env. For the research
# commands, load it with: uv run --env-file .env main.py ...

# Whale and Dolphin Orchestra (uv run start, uv run stop, bun run dev)
ORCHESTRA_PORT=3070
# 127.0.0.1 serves this machine only; 0.0.0.0 serves the network. The server has no login
# and starts GPU jobs, so on a shared server keep it behind a firewall or proxy.
ORCHESTRA_HOST=127.0.0.1
# ACE-Step 1.5 composes the pieces: auto installs it when an NVIDIA GPU is found; yes or no decide.
ORCHESTRA_ACE=auto
# Pick the GPU on a machine with several.
# CUDA_VISIBLE_DEVICES=0

# Hugging Face. Leave the token blank for public, ungated resources.
HF_TOKEN=
# Keep Hub downloads and token/cache files inside ignored local storage (relative to the repository).
HF_HOME=data/interim/huggingface
